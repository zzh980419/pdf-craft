[Unit]
Description=PDF Craft API Service
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/pdf-craft
Environment=PATH=/opt/pdf-craft/venv/bin
Environment=FLASK_ENV=production
EnvironmentFile=/opt/pdf-craft/.env
ExecStart=/opt/pdf-craft/venv/bin/gunicorn --bind 0.0.0.0:1157 --workers 2 --timeout 300 app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target